# Optional PostgreSQL / Supabase connection string for conference workflow scripts.
DATABASE_URL=
# Example: postgresql://user:password@localhost:5432/speaker_signal?sslmode=require

# Optional workflow fallback when DATABASE_URL is absent. Defaults to data/speaker-signal.db.
DATABASE_PATH=data/speaker-signal.db

# Optional. Enables rendered fallback for blocked or JavaScript-only pages.
FIRECRAWL_API_KEY=
